# HostelX Backend Environment Variables
# Copy this file to .env and configure these variables for production/development.

# Server listening port
PORT=5000

# MongoDB Connection String (e.g., MongoDB Atlas or local MongoDB)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/hostelx?retryWrites=true&w=majority

# Secret key for generating JWT tokens
JWT_SECRET=your_super_secret_jwt_key_here

# Cloudinary credentials for hosting product & profile images
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Dynamic Frontend Allowed Origins (Comma separated URLs)
# Add your custom Vercel domain here!
FRONTEND_URL=https://hostelx-pi.vercel.app,http://localhost:5173

# Firebase Admin SDK credentials (used to verify ID tokens from the
# frontend's Google/email sign-in, so the backend never has to trust
# a client-supplied email/name directly).
# Get these from: Firebase Console -> Project Settings -> Service
# Accounts -> Generate new private key -> open the downloaded JSON.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Comma-separated list of emails that should automatically get admin
# access. Do NOT hardcode these in source — set them here instead.
ADMIN_EMAILS=you@example.com
